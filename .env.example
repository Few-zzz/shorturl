# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง ห้าม commit ไฟล์ .env

# PostgreSQL (Neon) ใช้โดย link-service และ redirect-service
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full

# MongoDB (Atlas) ใช้โดย analytics-service
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/shorturl?appName=Cluster0

# ที่อยู่ของแต่ละ service ใช้โดย gateway และ redirect-service
LINK_SERVICE_URL=http://localhost:3001
REDIRECT_SERVICE_URL=http://localhost:3002
ANALYTICS_SERVICE_URL=http://localhost:3003

# URL สาธารณะของ gateway ใช้สร้างลิงก์ใน QR Code
PUBLIC_BASE_URL=http://localhost:3000
